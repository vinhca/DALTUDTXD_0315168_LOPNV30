<UserControl x:Class="DALTUDTXD_0315168_LOPNV30.UserControls.Menu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DALTUDTXD_0315168_LOPNV30.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="800">
    <Grid>
        <Ribbon SelectionChanged="Ribbon_SelectionChanged">
            <RibbonTab Header="Kết Nối">
                <RibbonGroup Header="ETABS">
                    <RibbonButton x:Name="btn_Etabs" Label="Kết nối Etabs"
                              Click="Btn_Etabs_Click"/>
                    <RibbonTextBox x:Name="rtb_Model" Label="Trạng thái:"
                               IsReadOnly="True" TextBoxWidth="140"/>
                </RibbonGroup>
            </RibbonTab>
        </Ribbon>
    </Grid>
</UserControl>
